/bin/

# Ignore all hidden files/folders created by IDEs and tooling
.*
!.gitignore
!.gitattributes
!.github/

# Project metadata generated by IDE/Eclipse
/.idea/
/.settings/
.classpath
.project
*.iml
bin

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
